---
/**
 * Sprint de Descoberta §6.3 #6 `how_it_happens` — "Como a Descoberta acontece".
 * when_data hasDiscoveryFormat: os 3 campos de descoberta.ts (formato,
 * participantes, ritmo) completos nos 3 idiomas; com qualquer um faltando a
 * seção inteira some. A duração não aparece (D44, 21/10/2026): o intro diz que
 * ela é definida com você no diagnóstico. Âncora: #como-acontece.
 * Dono: gated.
 *
 * AUTO-GATED. `data` existe só para os testes (flag e config injetados).
 */
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { descoberta, DISCOVERY_FIELDS, type Descoberta } from "@/config/descoberta";
import { getFeatures, type Features } from "@/config/features";
import { getSection, t, type Locale } from "@/i18n";

import FieldList from "./FieldList.astro";
import { ANCHORS } from "@/config/routes";

interface Props {
  locale: Locale;
  /** Só testes: flag e config injetados (tests/fixtures/). */
  data?: { features: Pick<Features, "hasDiscoveryFormat">; descoberta: Descoberta };
}

const { locale, data } = Astro.props;
const features = data?.features ?? (await getFeatures());
const source = data?.descoberta ?? descoberta;
const labels = getSection(locale, "discovery_sprint.how_it_happens.fields");
const items = features.hasDiscoveryFormat
  ? DISCOVERY_FIELDS.flatMap(([field, label]) => {
      const value = source[field]?.[locale]?.trim();
      return value ? [{ label: labels[label], value }] : [];
    })
  : [];
// Os 3 campos são obrigatórios: a flag já garante, isto só impede render parcial se alguém injetar dado incompleto.
const complete = items.length === DISCOVERY_FIELDS.length;
---

{
  features.hasDiscoveryFormat && complete && (
    <Section id={ANCHORS.discoveryFormat} labelledby={`${ANCHORS.discoveryFormat}-title`}>
      <SectionHeader
        id={`${ANCHORS.discoveryFormat}-title`}
        title={t(locale, "discovery_sprint.how_it_happens.title")}
        intro={t(locale, "discovery_sprint.how_it_happens.intro")}
      />
      <FieldList items={items} />
    </Section>
  )
}
