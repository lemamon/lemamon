---
/**
 * Grade de cards de case (interno do gated): Home #9, cases relacionados,
 * hub /cases e "Outros projetos" do case. O card é o CaseCard (home), um único
 * <a> que cobre a área. Lista empilhada no mobile, sem carrossel (BLUEPRINT §6.1 #9).
 *
 * `data-servicos` em cada item alimenta o filtro sem JS do hub (CasesHubView).
 */
import CaseCard from "@/components/shared/CaseCard.astro";
import type { Locale } from "@/i18n";
import type { CaseItem } from "@/lib/content";

interface Props {
  locale: Locale;
  items: CaseItem[];
  /** Colunas no desktop. */
  columns?: 2 | 3;
  /** Nível do título de cada card: 2 no hub (logo abaixo do H1), 3 dentro de uma seção com H2. */
  headingLevel?: 2 | 3;
}

const { locale, items, columns = 3, headingLevel = 3 } = Astro.props;
---

<ul role="list" class="case-grid" data-columns={columns}>
  {
    items.map((item) => (
      <li class="case-grid__item" data-case-item data-servicos={item.entry.data.servicos.join(" ")}>
        <CaseCard locale={locale} entry={item.entry} slug={item.slug} headingLevel={headingLevel} />
      </li>
    ))
  }
</ul>

<style>
  .case-grid {
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: minmax(0, 1fr);
  }
  .case-grid__item {
    display: grid;
  }
  @media (min-width: 640px) {
    .case-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .case-grid[data-columns="3"] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
