---
/**
 * Pedido enviado §7.8 #3 `whatsapp_now` — "Prefere adiantar pelo WhatsApp?".
 * Dono: conversion. Primário quando `schedule` está oculto (sem agenda).
 *
 * O href estático usa a mensagem genérica (post_submit_generic); o script da
 * página troca pela mensagem com o código do pedido (post_submit) quando há
 * resumo no sessionStorage. A mensagem não leva dado pessoal, só o código.
 *
 * Sem WhatsApp e sem agenda, aparece o e-mail (email_fallback, com ou sem
 * código) com o botão "Copiar" (i18n quote._notes.sent_contact).
 * Ritmo vertical: <Section spacing="compact" trim="start"> (B211).
 */
import CopyEmail from "@/components/shell/CopyEmail.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import Section from "@/components/ui/Section.astro";
import { empresa } from "@/config/empresa";
import { getFeatures } from "@/config/features";
import { t, tRaw, type Locale } from "@/i18n";
import { whatsappHref } from "@/lib/whatsapp";
import { postSubmitGenericMessage } from "@/lib/whatsapp-messages";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const features = await getFeatures();
const href = features.hasWhatsapp ? whatsappHref(postSubmitGenericMessage(locale)) : null;
const showEmail = !href && !features.hasAgenda;
const marker = "{email}";
const withCode = t(locale, "quote.sent.email_fallback", { email: marker }).split(marker);
const generic = t(locale, "quote.sent.email_fallback_generic", { email: marker }).split(marker);
---

{
  href && (
    <Section id="whatsapp-agora" spacing="compact" trim="start" labelledby="sent-whatsapp-title" class="sent-whatsapp">
      <div class="sent-whatsapp__inner">
        <h2 id="sent-whatsapp-title" class="sent-whatsapp__title">
          {t(locale, "quote.sent.whatsapp_now.text")}
        </h2>
        <Button
          href={href}
          variant={features.hasAgenda ? "outline" : "whatsapp"}
          size="lg"
          full="mobile"
          target="_blank"
          rel="noopener"
          data-track="whatsapp_click"
          data-source="quote_sent"
          data-sent-whatsapp=""
          data-template={tRaw(locale, "quote.whatsapp_messages.post_submit")}
        >
          <Icon name="whatsapp" />
          {t(locale, "quote.sent.whatsapp_now.button")}
          <span class="sr-only">{t(locale, "shared.a11y.opens_new_tab")}</span>
        </Button>
      </div>
    </Section>
  )
}
{
  showEmail && (
    <Section as="div" id="adiantar" spacing="compact" trim="start" class="sent-whatsapp">
      <div class="sent-whatsapp__inner">
        <p data-sent-email="generic">
          {generic[0]}
          <CopyEmail locale={locale} source="quote_sent" />
          {generic[1]}
        </p>
        <p data-sent-email="with-code" hidden>
          {withCode[0]}
          <span class="sent-whatsapp__email">{empresa.email}</span>
          {withCode[1]}
        </p>
      </div>
    </Section>
  )
}

<style>
  .sent-whatsapp__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .sent-whatsapp__title {
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
  }

  .sent-whatsapp__email {
    font-family: var(--font-mono);
    user-select: all;
  }
</style>
