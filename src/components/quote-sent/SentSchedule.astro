---
/**
 * Pedido enviado §7.8 #2 `schedule` — when_data hasAgenda. Dono: conversion.
 * "Quer adiantar? Escolha um horário agora", como link externo (sem embed: um
 * embed de terceiro exigiria consentimento e mudança na Política). Quando
 * ativo, é o CTA primário da página. AUTO-GATED: sem agenda, nada.
 * Evento schedule_click (script da QuoteSentView, atributo data-sent-schedule).
 * Ritmo vertical: <Section spacing="compact" trim="start"> (B211).
 */
import Button from "@/components/ui/Button.astro";
import Section from "@/components/ui/Section.astro";
import { agenda } from "@/config/agenda";
import { getFeatures } from "@/config/features";
import { t, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const features = await getFeatures();
---

{
  features.hasAgenda && (
    <Section id="agendar" spacing="compact" trim="start" labelledby="sent-schedule-title" class="sent-schedule">
      <div class="sent-schedule__inner">
        <h2 id="sent-schedule-title" class="sent-schedule__title">
          {t(locale, "quote.sent.schedule.title")}
        </h2>
        <p>{t(locale, "quote.sent.schedule.note")}</p>
        <Button href={agenda.url} size="lg" full="mobile" target="_blank" rel="noopener" data-sent-schedule="">
          {t(locale, "quote.sent.schedule.button")}
          <span class="sr-only">{t(locale, "shared.a11y.opens_new_tab")}</span>
        </Button>
      </div>
    </Section>
  )
}

<style>
  .sent-schedule__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-block: 1px solid var(--color-border-subtle);
  }

  .sent-schedule__title {
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
  }
</style>
