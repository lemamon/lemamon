---
/**
 * Como trabalhamos §6.2 #3 `why_this_order` — always. Dono: pages.
 * A crença por trás do método (preço antes de entender o problema é chute) e a
 * frase-síntese em destaque: "Primeiro a gente combina. Depois a gente constrói."
 * Seção respirada (contraste de densidade, 03-ui §3.5.2).
 * Desktop: grade de 12 colunas, 7 (texto) + 5 (frase-síntese) (B222).
 */
import Section from "@/components/ui/Section.astro";
import { getSection, t, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const paragraphs = getSection(locale, "how_we_work.why_this_order.paragraphs");
---

<Section id="por-que-nesta-ordem" labelledby="por-que-nesta-ordem-title" surface="subtle">
  <div class="why grid-12">
    <div class="why__text">
      <h2 id="por-que-nesta-ordem-title">{t(locale, "how_we_work.why_this_order.title")}</h2>
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <p class="why__highlight">{t(locale, "how_we_work.why_this_order.highlight")}</p>
  </div>
</Section>

<style>
  .why {
    row-gap: var(--space-10);
  }

  .why__text {
    display: grid;
    gap: var(--space-4);
    max-inline-size: var(--measure-prose);
  }

  .why__text p {
    color: var(--color-text-secondary);
  }

  .why__highlight {
    align-self: center;
    padding-inline-start: var(--space-6);
    border-inline-start: 4px solid var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .why__text {
      --span-lg: 7;
    }

    .why__highlight {
      --span-lg: 5;
    }
  }
</style>
