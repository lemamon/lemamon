---
/**
 * Contato §6.9 #2 `channels` — always. Dono: conversion.
 * Cards: Diagnóstico gratuito (selo "recomendado para projetos"; o ÚNICO botão
 * cheio da seção, §8.6) · WhatsApp (botão contornado, o mesmo peso do WhatsApp
 * do hero; sem número; some sem PUBLIC_WHATSAPP_NUMBER) · E-mail em texto com
 * "Copiar" (com NDA confirmado, a variante que cita NDA) · LinkedIn, GitHub,
 * Medium · "São Paulo, SP, Brasil".
 *
 * Perfis: BLUEPRINT §6.9 e §4 tratam os três como canais confirmados e os
 * listam sempre (como o footer, CONTRACT §15.1); a nota contact._notes.profiles
 * pede condicionar a perfis.ts.publicar. Vale o BLUEPRINT até o dono decidir.
 *
 * Ritmo vertical: <Section spacing="compact" trim="start"> (B211), emendada no hero.
 *
 * Primitivos (B214): cada canal é um <Card as="li" padding="sm"> (o destaque do
 * diagnóstico só troca a cor da borda) e cada perfil um <Card as="a"
 * interactive padding="sm">, como os perfis da Home (shared/Profiles.astro).
 * Aqui não há borda, raio, respiro nem fundo de cartão próprios.
 * Grade (B222): calha var(--grid-gap) e 1 coluna abaixo de 1024px; a partir
 * de 1024px, 4+4+4 com os três canais e 6+6 sem o WhatsApp (data-count). Os
 * perfis são 4+4+4 a partir de 768px, com a mesma calha.
 */
import CopyEmail from "@/components/shell/CopyEmail.astro";
import CtaDiagnosis from "@/components/shared/CtaDiagnosis.astro";
import WhatsAppCta from "@/components/shared/WhatsAppCta.astro";
import Card from "@/components/ui/Card.astro";
import Icon from "@/components/ui/Icon.astro";
import Section from "@/components/ui/Section.astro";
import { getFeatures } from "@/config/features";
import { PROFILE_IDS, perfis } from "@/config/perfis";
import { getSection, t, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
  whatsappMessage: string;
}

const { locale, whatsappMessage } = Astro.props;
const features = await getFeatures();
const channels = getSection(locale, "contact.channels");
const profiles = getSection(locale, "shared.profiles");
const profileOrder = ["linkedin", "github", "medium"] as const satisfies readonly (typeof PROFILE_IDS)[number][];
// Diagnóstico + e-mail sempre; WhatsApp só com número configurado.
const channelCount = features.hasWhatsapp ? 3 : 2;
---

<Section id="canais" spacing="compact" trim="start" labelledby="contact-channels-title" class="contact-channels">
  <div class="contact-channels__inner">
    <h2 id="contact-channels-title" class="contact-channels__title">{channels.title}</h2>
    <ul class="contact-channels__grid" role="list" data-count={String(channelCount)}>
      <Card as="li" padding="sm" class="channel channel--featured">
        <p class="channel__badge">{channels.diagnosis.badge}</p>
        <h3 class="channel__title">{channels.diagnosis.title}</h3>
        <p class="channel__text">{channels.diagnosis.text}</p>
        <CtaDiagnosis locale={locale} origem="contato-canais" size="md" full={true} />
      </Card>
      {
        features.hasWhatsapp && (
          <Card as="li" padding="sm" class="channel">
            <h3 class="channel__title">{channels.whatsapp.title}</h3>
            <p class="channel__text">{channels.whatsapp.text}</p>
            <WhatsAppCta locale={locale} message={whatsappMessage} source="contato-canais" variant="outline" size="md" full={true} />
          </Card>
        )
      }
      <Card as="li" padding="sm" class="channel">
        <h3 class="channel__title">{channels.email.title}</h3>
        <p class="channel__text">{features.confirm.nda ? channels.email.text_with_nda : channels.email.text}</p>
        <CopyEmail locale={locale} source="contato-canais" />
      </Card>
    </ul>

    <ul class="contact-channels__profiles" role="list">
      {
        profileOrder.map((id) => (
          <li>
            <Card
              as="a"
              interactive
              padding="sm"
              class="profile"
              href={perfis[id].url}
              target="_blank"
              rel="noopener"
              data-track="profile_click"
              data-profile={id}
            >
              <Icon name={id} size={20} />
              <span class="profile__name">{profiles[id].name}</span>
              <span class="profile__text">{profiles[id].text}</span>
              <span class="sr-only">{t(locale, "shared.a11y.opens_new_tab")}</span>
            </Card>
          </li>
        ))
      }
    </ul>

    <p class="contact-channels__location">
      <Icon name="map-pin" size={18} />
      {channels.location}
    </p>
  </div>
</Section>

<style>
  .contact-channels__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-channels__title {
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
  }

  /* Grade de seção (B222): calha do token; 1 coluna abaixo de 1024px. */
  .contact-channels__grid {
    display: grid;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1024px) {
    .contact-channels__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .contact-channels__grid[data-count="2"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Raiz = <Card as="li" padding="sm"> (borda, raio, respiro, fundo): aqui só
     o arranjo interno. */
  .contact-channels__grid :global(.channel) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  /* Destaque do diagnóstico: só a cor da borda (dupla, pelo anel interno). */
  .contact-channels__grid :global(.channel--featured) {
    border-color: var(--color-border-accent);
    box-shadow: var(--ring-inset) var(--color-border-accent);
  }

  .channel__badge {
    padding: var(--space-0-5) var(--space-2);
    border-radius: var(--radius-sm);
    background-color: var(--color-accent-subtle);
    color: var(--color-accent-on-subtle);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
    font-weight: var(--font-weight-bold);
  }

  .channel__title {
    font-size: var(--text-h4);
    line-height: var(--leading-h4);
  }

  .channel__text {
    flex: 1 1 auto;
    color: var(--color-text-secondary);
  }

  .contact-channels__profiles {
    display: grid;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .contact-channels__profiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Os três cards com a mesma altura na linha (o texto do LinkedIn quebra). */
  .contact-channels__profiles > li {
    display: flex;
  }

  /* Raiz = <Card as="a" interactive padding="sm"> (borda, raio, respiro, hover
     só com ponteiro fino, B192): aqui só o arranjo do ícone, nome e texto. */
  .contact-channels__profiles :global(.profile) {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: var(--space-3);
  }

  .profile__name {
    font-weight: var(--font-weight-bold);
  }

  .profile__text {
    grid-column: 2;
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    color: var(--color-text-secondary);
  }

  .contact-channels__location {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-secondary);
  }
</style>
