---
/**
 * Contato §6.9 #1 `hero` — always. Dono: conversion. ÚNICO H1.
 * Para projeto novo (ou sistema no ar), o caminho mais rápido é o diagnóstico
 * gratuito (→ /orcamento?origem=contato-hero: origem única por posição,
 * backlog B047); para o resto, os canais. WhatsApp
 * como secundário (some sem número).
 * Ritmo vertical: <Section spacing="hero-compact"> (B211).
 */
import CtaDiagnosis from "@/components/shared/CtaDiagnosis.astro";
import WhatsAppCta from "@/components/shared/WhatsAppCta.astro";
import Section from "@/components/ui/Section.astro";
import { t, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
  whatsappMessage: string;
}

const { locale, whatsappMessage } = Astro.props;
---

<Section spacing="hero-compact" labelledby="contact-title" class="contact-hero">
  <div class="contact-hero__inner">
    <h1 id="contact-title" class="contact-hero__title">{t(locale, "contact.hero.title")}</h1>
    <p class="lead">{t(locale, "contact.hero.subtitle")}</p>
    <div class="contact-hero__actions">
      <CtaDiagnosis locale={locale} origem="contato-hero" />
      <WhatsAppCta locale={locale} message={whatsappMessage} source="contato-hero" />
    </div>
    <p class="contact-hero__microcopy">{t(locale, "shared.cta.microcopy_diagnosis")}</p>
  </div>
</Section>

<style>
  .contact-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .contact-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    inline-size: 100%;
  }

  .contact-hero__microcopy {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    color: var(--color-text-secondary);
  }
</style>
