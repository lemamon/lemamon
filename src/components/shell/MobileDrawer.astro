---
/**
 * Drawer de navegação (< 1024px) — BLUEPRINT §8.1; backlog B205. Dono: shell.
 *
 * Tela cheia no mobile, painel lateral no tablet. Três faixas:
 *  1. topo fixo: logo + "Fechar menu";
 *  2. lista que rola: os 5 serviços (sem submenu), Sprint de Descoberta (rótulo
 *     curto; o "Antes de construir:" fica no dropdown do desktop), Como
 *     trabalhamos, Quanto custa, Cases*, Sobre*, Contato; no fim, e-mail com
 *     "Copiar", seletor de idioma e botão "Tema escuro" (ThemeToggle, B208);
 *  3. rodapé FIXO igual ao da barra fixa: CTA primário ("Pedir diagnóstico
 *     gratuito", vira "Continuar meu pedido" com rascunho; ?origem={pagina}-menu)
 *     + ícone de WhatsApp. O CTA aparece sem rolar em qualquer altura de tela
 *     (375×667, 390×664 do Safari com as barras), com ou sem Cases e Sobre.
 * Só a lista rola: topo e rodapé nunca cobrem o item focado (B075).
 *
 * <dialog> aberto com showModal() por src/scripts/drawer.ts: focus trap, Esc
 * fecha e o foco volta ao botão "Menu" (aria-expanded/aria-controls nele).
 */
import Icon from "@/components/ui/Icon.astro";
import { getFeatures } from "@/config/features";
import { quoteHref, urlFor, type QuoteAttribution, type RouteKey, type RouteParams } from "@/config/routes";
import { t, type Locale } from "@/i18n";
import { whatsappHref } from "@/lib/whatsapp";

import CopyEmail from "./CopyEmail.astro";
import LanguageSelector from "./LanguageSelector.astro";
import Logo from "./Logo.astro";
import { discoveryLink, mainLinks, navRouteFor, primaryCtaShortLabel, serviceLinks } from "./nav";
import ResumeLabel from "./ResumeLabel.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  route: RouteKey;
  params?: RouteParams;
  whatsappMessage: string;
  /** ?origem= do CTA do drawer. */
  ctaOrigin?: string;
  /** Atribuição além do ?origem= (servico, ref, entrada; Base.astro, B166). */
  quoteAttribution?: Omit<QuoteAttribution, "origem">;
}

const { locale, route, params, whatsappMessage, ctaOrigin = "menu", quoteAttribution } = Astro.props;
const features = await getFeatures();
const services = serviceLinks(locale);
const pages = [discoveryLink(locale, "footer"), ...mainLinks(locale, features)];
const section = navRouteFor(route);
const current = (key: RouteKey) => (key === route ? "page" : undefined);
const wa = whatsappHref(whatsappMessage);
const quoteUrl = urlFor("quote", locale);
const menuLabel = t(locale, "shared.header.menu_button");
const shortLabel = primaryCtaShortLabel(locale, features);
---

<dialog id="menu-drawer" class="drawer" data-drawer aria-label={menuLabel}>
  <div class="drawer__panel">
    <div class="drawer__top">
      <a href={urlFor("home", locale)} class="drawer__logo" aria-label={t(locale, "shared.header.logo_label")}>
        <Logo locale={locale} size="sm" />
      </a>
      <button type="button" class="drawer__close" data-drawer-close>
        <Icon name="close" size={22} />
        <span class="sr-only">{t(locale, "shared.a11y.close_menu")}</span>
      </button>
    </div>

    <div class="drawer__body">
      <nav class="drawer__nav" aria-label={t(locale, "shared.a11y.main_nav")}>
        <p class="drawer__group" id="drawer-services-label">{t(locale, "shared.header.nav.services")}</p>
        <ul role="list" class="drawer__list" aria-labelledby="drawer-services-label">
          {
            services.map((link) => (
              <li>
                <a class="drawer__link" href={link.href} aria-current={current(link.route)}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <ul role="list" class="drawer__list drawer__list--pages">
          {
            pages.map((link) => (
              <li>
                <a
                  class="drawer__link"
                  href={link.href}
                  aria-current={current(link.route)}
                  data-active={link.route === section ? "true" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="drawer__more">
        <div class="drawer__email">
          <CopyEmail locale={locale} source="menu" />
        </div>
        <LanguageSelector locale={locale} route={route} params={params} variant="full" class="drawer__languages" />
        <ThemeToggle locale={locale} />
      </div>
    </div>

    <div class="drawer__actions">
      <a
        class="drawer__cta"
        href={quoteHref(locale, { ...quoteAttribution, origem: ctaOrigin })}
        data-track="cta_click"
        data-cta-id="diagnosis"
        data-origem={ctaOrigin}
        data-resume-cta=""
        data-resume-href={quoteUrl}
      >
        <ResumeLabel locale={locale} short={shortLabel} />
      </a>
      {
        wa && (
          <a class="drawer__whatsapp" href={wa} target="_blank" rel="noopener" data-track="whatsapp_click" data-source="menu">
            <Icon name="whatsapp" size={26} />
            <span class="sr-only">
              {t(locale, "shared.cta.whatsapp")} {t(locale, "shared.a11y.opens_new_tab")}
            </span>
          </a>
        )
      }
    </div>
  </div>
</dialog>

<style>
  .drawer {
    position: fixed;
    inset: 0 0 0 auto;
    inline-size: 100%;
    max-inline-size: none;
    block-size: 100%;
    block-size: 100dvh;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background-color: var(--color-bg-canvas);
    color: var(--color-text-primary);
  }
  .drawer[open] {
    animation: drawer-in var(--duration-slow) var(--ease-out);
  }
  .drawer::backdrop {
    background-color: var(--color-bg-overlay);
  }
  :global(html:has(dialog[data-drawer][open])) {
    overflow: hidden;
  }
  @keyframes drawer-in {
    from {
      transform: translateX(100%);
    }
  }

  .drawer__panel {
    display: flex;
    flex-direction: column;
    block-size: 100%;
  }

  .drawer__top {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    min-block-size: var(--header-height);
    padding-inline: var(--gutter);
    border-block-end: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg-canvas);
  }
  .drawer__logo {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
    text-decoration: none;
  }
  .drawer__close {
    display: inline-grid;
    place-items: center;
    inline-size: var(--target-min);
    block-size: var(--target-min);
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-md);
    background-color: transparent;
    color: var(--color-text-primary);
  }
  .drawer__close:hover {
    background-color: var(--color-bg-subtle);
  }

  /* Só a lista rola; o foco nunca fica colado nas bordas dela (B075). */
  .drawer__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: var(--space-6);
    min-block-size: 0;
    padding: var(--space-4) var(--gutter) var(--space-6);
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-padding-block: var(--space-3);
  }

  .drawer__group {
    margin-block-end: var(--space-2);
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
    letter-spacing: var(--tracking-overline);
    text-transform: uppercase;
  }
  .drawer__list {
    display: grid;
  }
  .drawer__list--pages {
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border-subtle);
  }
  .drawer__link {
    display: flex;
    align-items: center;
    min-block-size: var(--target-option);
    padding-inline: var(--space-2);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
    text-decoration: none;
  }
  .drawer__link:hover {
    background-color: var(--color-bg-subtle);
    color: var(--color-text-primary);
  }
  .drawer__link[aria-current="page"],
  .drawer__link[data-active="true"] {
    background-color: var(--color-brand-subtle);
    color: var(--color-brand-on-subtle);
    font-weight: var(--font-weight-bold);
  }

  .drawer__more {
    display: grid;
    gap: var(--space-3);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border-subtle);
  }
  .drawer__email {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  /* Rodapé fixo do drawer: o mesmo par da barra fixa (CTA + WhatsApp). */
  .drawer__actions {
    display: flex;
    flex: none;
    gap: var(--space-2);
    padding: var(--space-3) var(--gutter) calc(var(--space-3) + env(safe-area-inset-bottom));
    border-block-start: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg-canvas);
    box-shadow: var(--shadow-lg);
  }
  .drawer__cta {
    /* Botão estreito: rótulo completo em 14px, depois o curto (ResumeLabel). */
    container: resume-cta / inline-size;
    display: inline-flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
    min-block-size: var(--target-cta);
    padding-inline: var(--space-4);
    border-radius: var(--radius-md);
    background-color: var(--color-accent);
    color: var(--color-text-on-accent);
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
  }
  .drawer__cta:hover,
  .drawer__cta:active {
    background-color: var(--color-accent-hover);
    color: var(--color-text-on-accent);
  }
  .drawer__whatsapp {
    display: inline-grid;
    flex: none;
    place-items: center;
    inline-size: var(--target-cta);
    block-size: var(--target-cta);
    border-radius: var(--radius-md);
    background-color: var(--color-whatsapp);
    color: var(--color-text-on-whatsapp);
  }
  .drawer__whatsapp:hover {
    background-color: var(--color-whatsapp-hover);
    color: var(--color-text-on-whatsapp);
  }

  @media (min-width: 48em) {
    .drawer {
      inline-size: min(28rem, 100%);
      box-shadow: var(--shadow-xl);
    }
  }

  /* Impressão / PDF (B114): nem aberto o drawer vai para o papel. */
  @media print {
    .drawer {
      display: none !important;
    }
  }
</style>
