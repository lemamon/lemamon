---
/**
 * Os 4 entregáveis da Sprint de Descoberta — BLUEPRINT §5.2. Dono: home.
 * API estável: `locale`, `level`.
 *
 * Exatamente 4 (entendimento do problema, escopo priorizado, protótipo,
 * plano com prazo e preço fechados); nada além disso até o dono confirmar.
 * Desenho: 4 células com bordas compartilhadas (2×2 a partir de 768px), cada
 * uma com o marcador de "entregue" e o título no nível pedido.
 */
import Icon from "@/components/ui/Icon.astro";
import { getSection, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
  /** Nível dos títulos de cada entregável. */
  level?: 3 | 4;
}

const { locale, level = 3 } = Astro.props;
const items = getSection(locale, "shared.discovery_deliverables");
const Heading = `h${level}` as "h3" | "h4";
---

<ul class="discovery-deliverables" role="list">
  {
    Object.entries(items).map(([id, item]) => (
      <li data-id={id}>
        <span class="dd__mark" aria-hidden="true">
          <Icon name="check" size={16} strokeWidth={2.5} />
        </span>
        <Heading class="dd__title">{item.title}</Heading>
        <p class="dd__text">{item.text}</p>
      </li>
    ))
  }
</ul>

<style>
  .discovery-deliverables {
    display: grid;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-border-default);
  }
  .discovery-deliverables li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    column-gap: var(--space-3);
    row-gap: var(--space-1);
    align-content: start;
    padding-block: var(--space-5);
    border-block-end: 1px solid var(--color-border-default);
  }
  .dd__mark {
    grid-row: span 2;
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: var(--radius-md);
    background-color: var(--color-brand-subtle);
    color: var(--color-brand-on-subtle);
  }
  .dd__title {
    font-size: var(--text-lg);
    line-height: var(--leading-h4); /* título curto: 1.3, não o 1.56 do texto */
  }
  .dd__text {
    color: var(--color-text-secondary);
  }
  @media (min-width: 768px) {
    .discovery-deliverables {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-inline-start: 1px solid var(--color-border-default);
    }
    .discovery-deliverables li {
      padding: var(--space-6);
      border-inline-end: 1px solid var(--color-border-default);
    }
  }
</style>
