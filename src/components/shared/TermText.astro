---
/**
 * Texto do i18n com a 1ª menção de cada termo virando toggletip (<Term
 * mode="tip">) — BLUEPRINT §5.9. Dono: home.
 *
 *   <p><TermText locale={locale} text={t(locale, "home.hero.subtitle")} terms={["mvp"]} /></p>
 *
 * O rótulo do termo vem da própria explicação (shared.terms.*, antes do ":"),
 * então funciona nos 3 idiomas sem chave nova. Se o termo não aparecer no
 * texto daquele idioma, o texto sai inteiro, sem toggletip (nunca quebra).
 * Cabe à página escolher em que texto fica a 1ª menção de cada termo.
 * Número + unidade ("2 semanas", "45-minute") não quebra (NoBreakText).
 * A pontuação colada no termo ("MVPs.", "(MVP)") vai junto com ele num span
 * .no-break (glueTermPunctuation, B001): o botão do toggletip é uma caixa
 * atômica e o ponto cairia sozinho no começo da linha seguinte.
 */
import { t, type Locale } from "@/i18n";

import NoBreakText from "./NoBreakText.astro";
import Term from "./Term.astro";
import { glueTermPunctuation, splitTerms, termLabel, type TermId } from "./terms";

interface Props {
  locale: Locale;
  text: string;
  terms: readonly TermId[];
}

const { locale, text, terms } = Astro.props;
const segments = glueTermPunctuation(
  splitTerms(
    text,
    terms.map((term) => ({ term, label: termLabel(t(locale, `shared.terms.${term}`)) })),
  ),
);
---

{
  segments.map((segment) =>
    segment.kind === "text" ? (
      <NoBreakText text={segment.value} />
    ) : segment.before || segment.after ? (
      <span class="no-break term-tip__glue">{segment.before}<Term locale={locale} term={segment.term} mode="tip">{segment.value}</Term>{segment.after}</span>
    ) : (
      <Term locale={locale} term={segment.term} mode="tip">
        {segment.value}
      </Term>
    ),
  )
}
