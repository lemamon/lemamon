---
/**
 * Cases — hub /cases (BLUEPRINT §6.10) — when_data hasCases (≥ 2 cases
 * publicados nos 3 idiomas). Dono: gated. Só é gerada pelo pages/[gated].astro
 * com a flag ligada: sem dado não existe HTML, sitemap, hreflang, menu nem footer.
 *
 * hero (H1 + intro) → filters (chips por serviço só com ≥ 6 cases e só os
 * serviços que têm case; SEM JS: rádios + CSS :has(); sem suporte, todos
 * aparecem) → grid (CaseCard) → cta_final "Quer algo parecido?".
 *
 * `data` existe só para os testes (cases e flags injetados).
 */
import CaseGrid from "@/components/gated/CaseGrid.astro";
import CtaFinal from "@/components/shared/CtaFinal.astro";
import Section from "@/components/ui/Section.astro";
import { getFeatures, type Features } from "@/config/features";
import { SERVICE_KEYS } from "@/config/routes";
import { getSection, t, type Locale } from "@/i18n";
import { caseItems, type CaseItem } from "@/lib/content";
import { pageMessage } from "@/lib/whatsapp-messages";
import Base from "@/layouts/Base.astro";

interface Props {
  locale: Locale;
  /** Só testes: flags e cases injetados (tests/fixtures/). */
  data?: { features: Pick<Features, "hasCaseFilters">; items: CaseItem[] };
}

const { locale, data } = Astro.props;
const features = data?.features ?? (await getFeatures());
const items = data?.items ?? (await caseItems(locale));
const filters = getSection(locale, "cases.hub.filters");
const services = SERVICE_KEYS.filter((key) => items.some((item) => item.entry.data.servicos.includes(key)));
const showFilters = features.hasCaseFilters && services.length > 1;
const whatsappMessage = pageMessage(locale, t(locale, "shared.breadcrumb.cases"));
---

<Base
  locale={locale}
  route="cases_hub"
  title={t(locale, "meta.cases_hub.title")}
  description={t(locale, "meta.cases_hub.description")}
  whatsappMessage={whatsappMessage}
  ctaOrigin="cases-barra"
>
  <Section spacing="spacious" labelledby="cases-hub-title">
    <div class="hub-hero">
      <h1 id="cases-hub-title">{t(locale, "cases.hub.title")}</h1>
      <p class="lead">{t(locale, "cases.hub.intro")}</p>
    </div>
  </Section>

  <Section id="lista" spacing="compact" label={t(locale, "shared.breadcrumb.cases")}>
    <div class="hub-list">
      {
        showFilters && (
          <fieldset class="hub-filters">
            <legend class="hub-filters__legend">{filters.label}</legend>
            <div class="hub-filters__chips">
              <label class="chip">
                <input type="radio" name="filtro-servico" value="all" checked />
                <span>{filters.all}</span>
              </label>
              {services.map((key) => (
                <label class="chip">
                  <input type="radio" name="filtro-servico" value={key} />
                  <span>{filters[key]}</span>
                </label>
              ))}
            </div>
          </fieldset>
        )
      }
      <CaseGrid locale={locale} items={items} headingLevel={2} />
    </div>
  </Section>

  <CtaFinal
    locale={locale}
    origem="cases-final"
    title={t(locale, "cases.hub.cta_final.title")}
    text={t(locale, "cases.hub.cta_final.text")}
    whatsappMessage={whatsappMessage}
  />
</Base>

<style>
  .hub-hero {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .hub-hero h1 {
    max-inline-size: 20ch;
  }
  .hub-filters {
    margin: 0 0 var(--space-8);
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }
  .hub-filters__legend {
    margin-block-end: var(--space-3);
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }
  .hub-filters__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--target-min);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-full);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: var(--transition-colors);
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inline-size: 1px;
    block-size: 1px;
  }
  .chip:has(input:focus-visible) {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  /* Selecionado: borda, fundo E peso do texto (nunca só cor). */
  .chip:has(input:checked) {
    border-color: var(--color-brand);
    background-color: var(--color-brand-subtle);
    font-weight: var(--font-weight-bold);
  }
  .chip:has(input:checked)::before {
    content: "";
    inline-size: var(--space-2);
    block-size: var(--space-2);
    border-radius: var(--radius-full);
    background-color: var(--color-brand);
  }

  /* Filtro sem JS: só esconde quando o navegador entende :has(). */
  .hub-list:has(input[value="web_systems"]:checked) :global([data-case-item]:not([data-servicos~="web_systems"])),
  .hub-list:has(input[value="mobile_apps"]:checked) :global([data-case-item]:not([data-servicos~="mobile_apps"])),
  .hub-list:has(input[value="integrations"]:checked) :global([data-case-item]:not([data-servicos~="integrations"])),
  .hub-list:has(input[value="mvp"]:checked) :global([data-case-item]:not([data-servicos~="mvp"])),
  .hub-list:has(input[value="support"]:checked) :global([data-case-item]:not([data-servicos~="support"])) {
    display: none;
  }
</style>
