# Yarn 1 (packageManager: yarn@1.22.22).
# vitest, jsdom and part of the Vite toolchain declare "engines" that list only
# even-numbered Node lines (^22 || >=24). Local machines on Node 23 would fail
# `yarn install` on that check alone. Netlify builds on NODE_VERSION 22, where
# the engines match; astro's own floor (>=22.22) is enforced by package.json.
ignore-engines true
